generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  analista_legal
  abogada_junior
  cliente

  @@map("role_enum")
}

enum TipoPersona {
  natural
  juridica

  @@map("tipo_persona_enum")
}

/// Tipo de cuenta de cartera (ex tipo_propiedad): inmueble u otro.
enum TipoCuenta {
  apartamento
  oficina
  local
  casa
  bodega
  garaje
  parqueadero
  otro

  @@map("tipo_cuenta_enum")
}

enum EstadoPago {
  pendiente
  parcial
  pagado
  vencido

  @@map("estado_pago_enum")
}

enum ConceptoPago {
  administracion
  intereses
  extraordinaria
  otros

  @@map("concepto_pago_enum")
}

enum TipoProcesoLegal {
  juridica
  extrajudicial
  acuerdo_de_pago

  @@map("tipo_proceso_legal_enum")
}

enum EstadoProcesoLegal {
  activa
  cerrada
  en_proceso

  @@map("estado_proceso_legal_enum")
}

enum EtapaProceso {
  radicacion
  inadmision
  subsanacion
  mandamiento_de_pago
  medidas_radicadas
  notificacion
  sentencia
  liquidacion_de_costas
  ejecucion
  liquidacion_del_credito
  remate
  rechazado
  terminacion

  @@map("etapa_proceso_enum")
}

model Cliente {
  id            String      @id @default(uuid())
  nombre        String
  tipo_persona  TipoPersona
  documento     String      @unique
  telefono      String?
  email         String      @unique
  direccion     String?
  observaciones String?
  is_active     Boolean     @default(true)

  cuentas   Cuenta[]
  creditors Creditor[]
  usuarios  Usuario[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("clientes")
}

/// Acreedor (cliente del cliente SaaS): entrega cartera a cobrar.
/// Fase 1–2: cuelga del tenant (`cliente_id`); las cuentas aún conservan `cliente_id` legacy.
model Creditor {
  id            String      @id @default(uuid())
  cliente_id    String
  cliente       Cliente     @relation(fields: [cliente_id], references: [id])
  nombre        String
  tipo_persona  TipoPersona
  documento     String
  telefono      String?
  email         String?
  direccion     String?
  observaciones String?
  is_active     Boolean     @default(true)

  cuentas Cuenta[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([cliente_id, documento], map: "creditors_cliente_documento_key")
  @@index([cliente_id], map: "idx_creditors_cliente_id")
  @@map("creditors")
}

model Usuario {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password_hash          String?
  role                   Role
  cliente_id             String?
  cliente                Cliente?  @relation(fields: [cliente_id], references: [id])
  is_active              Boolean   @default(true)
  activation_token_hash  String?   @unique
  activation_expires_at  DateTime?
  activated_at           DateTime?

  refresh_tokens RefreshToken[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("usuarios")
}

/// Cuenta de cartera (ex propiedad): lo que el acreedor entrega para cobrar.
model Cuenta {
  id              String    @id @default(uuid())
  /// Legacy/compat API: dueño operativo actual (sigue siendo el filtro del front).
  cliente_id      String
  cliente         Cliente   @relation(fields: [cliente_id], references: [id])
  /// Fase 1–2: acreedor bajo el tenant SaaS (LegalTech). Nullable hasta backfill.
  creditor_id     String?
  creditor        Creditor? @relation(fields: [creditor_id], references: [id])
  tipo_cuenta     TipoCuenta
  identificador   String
  direccion       String?
  notas           String?

  cobro_nombre       String
  cobro_tipo_persona TipoPersona
  cobro_documento    String
  cobro_email        String?

  monto_a_la_fecha Decimal @default(0) @db.Decimal(14, 2)

  edad_mora_dias Int?
  fecha_inicio_cobro DateTime? @db.Date
  fecha_fin_cobro    DateTime? @db.Date

  historial_pagos  HistorialPago[]
  gestiones        Gestion[]
  procesos_legales ProcesoLegal[]
  cuenta_deudores  CuentaDeudor[]

  /// Soft delete: conserva la cuenta y sus registros para auditoría.
  deleted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cliente_id], map: "idx_cuentas_cliente_id")
  @@index([creditor_id], map: "idx_cuentas_creditor_id")
  @@index([deleted_at], map: "idx_cuentas_deleted_at")
  @@map("cuentas")
}

/// Persona/entidad a quien se cobra (no pertenece al Cliente).
model Deudor {
  id           String      @id @default(uuid())
  nombre       String
  tipo_persona TipoPersona
  documento    String      @unique
  emails       String[]
  telefono     String?

  cuentas CuentaDeudor[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("deudores")
}

/// Solo relaciona ids: cuenta ↔ deudor.
model CuentaDeudor {
  cuenta_id String
  deudor_id String

  cuenta Cuenta @relation(fields: [cuenta_id], references: [id], onDelete: Cascade)
  deudor Deudor @relation(fields: [deudor_id], references: [id], onDelete: Restrict)

  @@id([cuenta_id, deudor_id], map: "cuenta_deudores_pkey")
  @@map("cuenta_deudores")
}

model HistorialPago {
  id        String @id @default(uuid())
  cuenta_id String
  cuenta    Cuenta @relation(fields: [cuenta_id], references: [id])

  periodo          String        @db.Char(7)
  concepto         ConceptoPago
  valor_cobrado    Decimal       @db.Decimal(14, 2)
  valor_pagado     Decimal       @db.Decimal(14, 2)
  fecha_pago       DateTime?     @db.Date
  estado_pago      EstadoPago
  monto_a_la_fecha Decimal       @db.Decimal(14, 2)

  dias_en_mora Int?
  fecha_inicio_cobro DateTime? @db.Date
  fecha_fin_cobro    DateTime? @db.Date

  observaciones String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  /// Soft delete: conserva la fila para auditoría y la excluye de cálculos operativos.
  deleted_at DateTime?

  @@index([cuenta_id, periodo], map: "idx_historial_cuenta_periodo")
  @@index([deleted_at], map: "idx_historial_pagos_deleted_at")
  @@map("historial_pagos")
}

/// Expediente / proceso legal: cuelga solo de la cuenta (creditor → cuenta → proceso).
model ProcesoLegal {
  id        String @id @default(uuid())
  cuenta_id String
  cuenta    Cuenta @relation(fields: [cuenta_id], references: [id])

  numero_cuenta String              @unique
  tipo          TipoProcesoLegal
  estado        EstadoProcesoLegal
  etapa_proceso EtapaProceso

  /// Soft delete: ocultar de listados sin borrar la fila (auditoría).
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cuenta_id], map: "idx_procesos_legales_cuenta_id")
  @@index([deleted_at], map: "idx_procesos_legales_deleted_at")
  @@map("procesos_legales")
}

enum TipoGestion {
  manual
  email_reminder

  @@map("tipo_gestion_enum")
}

/// Evento de timeline de cobro. En email_reminder, `descripcion` guarda
/// JSON con subject, destinatarios, body_html, body_text, etc.
model Gestion {
  id        String @id @default(uuid())
  cuenta_id String
  cuenta    Cuenta @relation(fields: [cuenta_id], references: [id])

  fecha       DateTime
  tipo        TipoGestion
  estado      String
  descripcion String   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cuenta_id, fecha])
  @@map("gestiones")
}

model RefreshToken {
  id         String   @id @default(uuid())
  usuario_id String
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  token_hash           String
  expires_at           DateTime
  session_expires_at   DateTime
  last_used_at         DateTime
  revoked_at           DateTime?
  replaced_by_token_id String?

  created_at DateTime @default(now())

  @@index([usuario_id], map: "idx_refresh_tokens_usuario")
  @@map("refresh_tokens")
}
