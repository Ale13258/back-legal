{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --include=dev",
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/tutelas/alertas/cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/v1/pqrs/alertas/cron",
      "schedule": "5 13 * * *"
    }
  ]
}
