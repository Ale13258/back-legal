generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  cliente

  @@map("role_enum")
}

enum TipoPersona {
  natural
  juridica

  @@map("tipo_persona_enum")
}

enum TipoPropiedad {
  apartamento
  oficina
  local
  casa
  bodega
  garaje
  parqueadero
  otro

  @@map("tipo_propiedad_enum")
}

enum EstadoPago {
  pendiente
  parcial
  pagado
  vencido

  @@map("estado_pago_enum")
}

enum ConceptoPago {
  administracion
  intereses
  extraordinaria
  otros

  @@map("concepto_pago_enum")
}

enum TipoCuenta {
  juridica
  extrajudicial
  acuerdo_de_pago

  @@map("tipo_cuenta_enum")
}

enum EstadoCuenta {
  activa
  cerrada
  en_proceso

  @@map("estado_cuenta_enum")
}

enum EtapaProceso {
  radicacion
  inadmision
  subsanacion
  mandamiento_de_pago
  medidas_radicadas
  notificacion
  sentencia
  liquidacion_de_costas
  ejecucion
  liquidacion_del_credito
  remate
  rechazado
  terminacion

  @@map("etapa_proceso_enum")
}

model Cliente {
  id            String      @id @default(uuid())
  nombre        String
  tipo_persona  TipoPersona
  documento     String      @unique
  telefono      String?
  email         String      @unique
  direccion     String?
  observaciones String?
  is_active     Boolean     @default(true)

  propiedades Propiedad[]
  cuentas     Cuenta[]
  usuarios    Usuario[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("clientes")
}

model Usuario {
  id             String    @id @default(uuid())
  email          String    @unique
  password_hash  String
  role           Role
  cliente_id     String?
  cliente        Cliente?  @relation(fields: [cliente_id], references: [id])

  refresh_tokens RefreshToken[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("usuarios")
}

model Propiedad {
  id              String         @id @default(uuid())
  cliente_id      String
  cliente         Cliente        @relation(fields: [cliente_id], references: [id])
  tipo_propiedad  TipoPropiedad
  identificador   String
  direccion       String?
  notas           String?

  cobro_nombre       String
  cobro_tipo_persona TipoPersona
  cobro_documento    String
  cobro_email        String
  /// Deudores de cobro (JSON: DeudorCobro[] con emails[]). cobro_* = deudores[0] / emails[0].
  deudores           Json

  monto_a_la_fecha Decimal @default(0) @db.Decimal(14, 2)

  /// Máximo de dias_en_mora en historial de esta propiedad (denormalizado para listados).
  edad_mora_dias Int?
  /// MIN(fecha_inicio_cobro) del historial (no null).
  fecha_inicio_cobro DateTime? @db.Date
  /// MAX(fecha_fin_cobro) del historial (no null).
  fecha_fin_cobro    DateTime? @db.Date

  historial_pagos HistorialPago[]
  gestiones       Gestion[]
  cuentas         Cuenta[]
  payment_reminder_emails PaymentReminderEmail[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cliente_id], map: "idx_propiedades_cliente_id")
  @@map("propiedades")
}

model PaymentReminderEmail {
  id               String    @id @default(uuid())
  propiedad_id     String
  propiedad        Propiedad @relation(fields: [propiedad_id], references: [id])
  cliente_email    String
  /// Destinatarios adicionales (cliente_email = principal).
  extra_recipients String[]  @default([])
  subject          String
  body_html        String?   @db.Text
  body_text        String?   @db.Text
  status           String
  provider_id      String?
  error_message    String?
  sent_at          DateTime?
  created_at       DateTime  @default(now())

  gestion Gestion?

  @@index([propiedad_id, created_at(sort: Desc)], map: "idx_payment_reminder_emails_propiedad_created")
  @@map("payment_reminder_emails")
}

model HistorialPago {
  id           String    @id @default(uuid())
  propiedad_id String
  propiedad    Propiedad @relation(fields: [propiedad_id], references: [id])

  periodo          String        @db.Char(7)
  concepto         ConceptoPago
  valor_cobrado    Decimal       @db.Decimal(14, 2)
  valor_pagado     Decimal       @db.Decimal(14, 2)
  fecha_pago       DateTime?     @db.Date
  estado_pago      EstadoPago
  monto_a_la_fecha Decimal       @db.Decimal(14, 2)

  /// Calculado en servidor; ver BACKEND_API §6.5.1 y domain/mora.ts.
  dias_en_mora Int?
  fecha_inicio_cobro DateTime? @db.Date
  fecha_fin_cobro    DateTime? @db.Date

  observaciones String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([propiedad_id, periodo], map: "idx_historial_propiedad_periodo")
  @@map("historial_pagos")
}

model Cuenta {
  id            String    @id @default(uuid())
  cliente_id    String
  cliente       Cliente   @relation(fields: [cliente_id], references: [id])
  propiedad_id  String?
  propiedad     Propiedad? @relation(fields: [propiedad_id], references: [id])

  numero_cuenta String       @unique
  tipo          TipoCuenta
  estado        EstadoCuenta
  etapa_proceso EtapaProceso

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cliente_id], map: "idx_cuentas_cliente_id")
  @@map("cuentas")
}

model Gestion {
  id           String    @id @default(uuid())
  propiedad_id String
  propiedad    Propiedad @relation(fields: [propiedad_id], references: [id])

  /// Instant UTC (timestamptz). No date-only.
  fecha       DateTime
  estado      String
  descripcion String
  /// p.ej. "email_reminder" para gestiones auto-creadas al enviar recordatorio.
  origen      String?
  email_reminder_id String?               @unique
  email_reminder    PaymentReminderEmail? @relation(fields: [email_reminder_id], references: [id], onDelete: Restrict)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([propiedad_id, fecha])
  @@map("gestiones")
}

model RefreshToken {
  id         String   @id @default(uuid())
  usuario_id String
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  token_hash           String
  expires_at           DateTime
  session_expires_at   DateTime
  last_used_at         DateTime
  revoked_at           DateTime?
  replaced_by_token_id String?

  created_at DateTime @default(now())

  @@index([usuario_id], map: "idx_refresh_tokens_usuario")
  @@map("refresh_tokens")
}
